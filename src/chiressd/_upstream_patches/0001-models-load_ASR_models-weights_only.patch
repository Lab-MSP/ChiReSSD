# ChiReSSD patch 1/2 against yl4579/StyleTTS2 @ 5cedc71c333f8d8b8551ca59378bdcc7af4c9529
#
# PyTorch 2.6 flipped the default of torch.load() to weights_only=True, which
# refuses the pickled ASRCNN config in the upstream text-aligner checkpoint.
# Compatibility only -- no effect on model behaviour.
