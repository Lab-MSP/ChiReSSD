# --- author-facing notes ---
# These live in the sibling repository ../chiressd-local. The pattern stays as a
# safety net so a stray local note here can never be committed by accident.
*.local.md


# The model card is published on the Hugging Face repo, not here. Kept
# locally so the two stay in sync when the checkpoint is updated.
MODEL_CARD.md

# --- local configuration ---
paths.yaml
.env

# --- upstream checkout + scratch work ---
third_party/
work/
outputs/
runs/
run-*/

# --- data & model artifacts: nothing of this kind belongs in git ---
*.wav
*.mp3
*.flac
*.mp4
*.npy
*.pth
*.pt
*.t7
*.ckpt
*.safetensors
*.csv
*.tsv
*.xlsx
*.TextGrid

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

